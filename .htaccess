<IfModule mod_rewrite.c>
    RewriteEngine On
        
    RewriteCond %{HTTP:CF-Visitor} '"scheme":"http"'
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+404\.(?:php|html)(?:[?\s]) [NC]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^404\.(?:php|html)$ - [R=404,L]

    RewriteCond %{ENV:REDIRECT_STATUS} ^404$
    RewriteCond %{DOCUMENT_ROOT}/404.php -f
    RewriteRule ^__mobicore_404$ 404.php [END]

    RewriteCond %{ENV:REDIRECT_STATUS} ^404$
    RewriteCond %{DOCUMENT_ROOT}/404.html -f
    RewriteRule ^__mobicore_404$ 404.html [END]

    RewriteCond %{THE_REQUEST} \s/+index(?:\.(?:php|html))?(?:[?\s]) [NC]
    RewriteRule ^index(?:\.(?:php|html))?$ https://%{HTTP_HOST}/ [R=301,L]

    RewriteCond %{DOCUMENT_ROOT}/$1.php -f
    RewriteRule ^(.+)\.html$ https://%{HTTP_HOST}/$1.php [R=301,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.+)\.php$ https://%{HTTP_HOST}/$1.html [R=301,L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.php -f
    RewriteRule ^(.+?)/?$ https://%{HTTP_HOST}/$1.php [R=301,L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.+?)/?$ https://%{HTTP_HOST}/$1.html [R=301,L]

    DirectoryIndex index.php index.html

</IfModule>

ErrorDocument 404 /__mobicore_404

<IfModule mod_headers.c>
    Header always set Content-Security-Policy "upgrade-insecure-requests;"
</IfModule>

<FilesMatch "^404\.(?:php|html)$">
    Header always set X-Robots-Tag "noindex, nofollow"
</FilesMatch>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-font-ttf "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType application/rss+xml "access plus 1 hour"
    ExpiresByType application/atom+xml "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

Options -Indexes
AddDefaultCharset UTF-8
